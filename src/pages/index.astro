---
/* The group entrance, like blackandbluesteakhouse.ca/: choose a location. Each plate loops that location's own room or sign. */
import Layout from "@/layouts/Layout.astro";
import { url } from "@/lib/url";
import { locations } from "@/data/locations";

const loops: Record<string, string> = { toronto: "tor-home", vancouver: "van-home", roof: "roof-home" };
const marks: Record<string, string> = { toronto: "assets/brand/logo-toronto.png", vancouver: "assets/brand/logo-vancouver.png", roof: "assets/brand/roof-gold.png" };
---
<Layout
  title="Black+Blue | The Golden Age of Steak · Toronto, Vancouver, The Roof"
  description="Black+Blue, Canada’s premier steak dining experience: Kobe-Beef certified steakhouses in Toronto and Vancouver, and The Roof, Vancouver’s largest rooftop dining destination."
  path=""
>
<main class="page chooser">
  <section class="chooser-head wrap">
    <span class="eyebrow">A Glowbal Restaurant Group dining destination</span>
    <h1>The Golden Age <em>of Steak</em></h1>
    <p class="lede">Black+Blue is Canada’s premier steak dining experience with locations in Vancouver and Toronto offering the magic of a classic steak house combined with a modern and energetic ambiance.</p>
  </section>
  <section class="wrap chooser-grid">
    {locations.map((l) => (
      <a class="chooser-card" href={url(`${l.slug}/`)}>
        <figure class="print">
          <img src={url(`assets/loops/${loops[l.key]}.webp`)} alt="" width="1600" height="900" />
          <video autoplay muted loop playsinline preload="metadata" poster={url(`assets/loops/${loops[l.key]}.webp`)} aria-hidden="true"><source src={url(`assets/loops/${loops[l.key]}.mp4`)} type="video/mp4" /></video>
        </figure>
        <img class={`chooser-mark${l.key === "roof" ? " roof" : ""}`} src={url(marks[l.key])} alt={l.name} width="300" height="250" loading="lazy" />
        <span class="chooser-meta">{l.address.line2 ? `${l.address.line2} · ` : ""}{l.address.street}, {l.address.city}</span>
        <span class="link-arrow">Enter {l.short}</span>
      </a>
    ))}
  </section>
</main>
</Layout>
