---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/site.config";
import { url } from "@/lib/url";
---
<Layout title="Page not found | Black+Blue Toronto" description="This page has moved." path="404/">
<main class="page">
  <section class="page-hero" style="border:0">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This lot has been <em>withdrawn.</em></h1>
      <div class="actions"><a class="btn btn-solid" href={url("menu/")}>Menu</a><a class="btn" href={site.book}>Book a Table</a><a class="link-arrow" href={url()}>Home</a></div>
    </div>
  </section>
</main>
</Layout>
