---
import Layout from "@/layouts/Layout.astro";
import LoopHero from "@/components/LoopHero.astro";
import { url, absolute, locHref } from "@/lib/url";
import { locations, type Location } from "@/data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({ params: { loc: loc.slug }, props: { loc } }));
}
const { loc } = Astro.props as { loc: Location };
const hero = loc.heroes.private!;
const pd = loc.privateDining;
const path = `${loc.slug}/private-dining/`;
const schema = [
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: pd.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: loc.name, item: absolute(`${loc.slug}/`) },
    { "@type": "ListItem", position: 2, name: "Private Dining", item: absolute(path) },
  ] },
];
---
<Layout
  title={`Private Dining & Group Events | ${loc.name}`.slice(0, 64)}
  description={`Private dining, group menus and full buyouts at ${loc.name}, ${loc.address.street}, ${loc.address.city}. Event request and group FAQ.`}
  path={path} current="private" schema={schema} loc={loc}
>
<main class="page">
  <LoopHero loop={hero.loop} label={hero.label}>
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url(`${loc.slug}/`)}>{loc.short}</a><span>/</span>Private Dining</nav>
      <h1 style="margin-top:1rem">{hero.title[0]} <em>{hero.title[1]}</em></h1>
    </div>
    <div>
      <p class="lede">{hero.lede}</p>
      {hero.actions && <div class="actions">{hero.actions.map(([l, x], i) => <a class={i === 0 ? "btn btn-solid btn-sm" : "link-arrow"} href={locHref(loc.slug, x)}>{l}</a>)}</div>}
    </div>
  </LoopHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><span class="eyebrow">A Premier Dining Experience</span><h2>Spaces for <em>every occasion</em></h2></div>
        <div>{pd.intro.map((p, i) => <p style={i ? "margin-top:1rem" : undefined}>{p}</p>)}</div>
      </div>
      <div class="rooms reveal" style={`grid-template-columns:repeat(${pd.rooms.length},minmax(0,1fr))`}>
        {pd.rooms.map((r) => <div><span class="figure">{r.figure}</span><span class="label">{r.label}</span></div>)}
      </div>
      {pd.roomsConfirm && <Fragment set:html={`<!-- CONFIRM: ${pd.roomsConfirm} -->`} />}
      <div class="actions" style="margin-top:2rem">
        <a class="link-arrow" href={loc.groupMenus}>Group Menus</a>
        <a class="link-arrow" href={loc.festive}>Festive Info</a>
        <a class="link-arrow" href={loc.tour}>Virtual Tour</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="gallery">
        {pd.gallery.map((g) => <figure class={`print reveal${g.wide ? " wide" : ""}`}><img src={url(`assets/img/${g.img}.webp`)} alt={g.alt} loading="lazy" width="1600" height="1067" /></figure>)}
      </div>
    </div>
  </section>

  <section class="section" id="inquiry">
    <div class="wrap form-layout">
      <div class="sticky reveal">
        <span class="eyebrow">Event Request</span>
        <h2 class="h2" style="margin:1rem 0 1.4rem">Plan a <em>group dinner</em></h2>
        <p class="ink-soft">{pd.formNote}</p>
        <!-- CONFIRM: reply time the events team stands behind -->
        <dl class="contact-details" style="margin-top:2rem">
          <div><dt>Events</dt><dd><a href={loc.events}>Request through Tripleseat</a></dd></div>
          <div><dt>Call</dt><dd><a href={loc.tel}>{loc.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${loc.email}`}>{loc.email}</a></dd></div>
        </dl>
      </div>
      <div>
        <form class="form reveal" method="post" data-form={`private-dining-${loc.slug}`} data-form-type="private_event">
          <input type="hidden" name="location" value={loc.name} />
          <div class="row"><div class="field"><label for="pd_name">Name*</label><input id="pd_name" name="name" type="text" autocomplete="name" required /></div><div class="field"><label for="pd_company">Company</label><input id="pd_company" name="company" type="text" autocomplete="organization" /></div></div>
          <div class="row"><div class="field"><label for="pd_email">Email*</label><input id="pd_email" name="email" type="email" autocomplete="email" required /></div><div class="field"><label for="pd_phone">Phone*</label><input id="pd_phone" name="phone" type="tel" autocomplete="tel" required /></div></div>
          <div class="row"><div class="field"><label for="pd_date">Preferred date*</label><input id="pd_date" name="date" type="date" required /></div><div class="field"><label for="pd_guests">Guests*</label><input id="pd_guests" name="guests" type="number" min="2" max={pd.maxGuests} required /></div></div>
          <div class="row">
            <div class="field"><label for="pd_occasion">Occasion</label><select id="pd_occasion" name="occasion"><option value="">Select…</option><option>Corporate holiday party</option><option>Team dinner</option><option>Client reception</option><option>Holiday lunch</option><option>Wedding or celebration</option><option>Birthday or anniversary</option><option>Other</option></select></div>
            <div class="field"><label for="pd_space">Space</label><select id="pd_space" name="space"><option value="">Select…</option>{pd.spaces.map((s) => <option>{s}</option>)}</select></div>
          </div>
          <div class="field"><label for="pd_message">Anything else</label><textarea id="pd_message" name="message" placeholder="Time, dietary needs, A/V, a cake…"></textarea></div>
          <button class="btn btn-solid btn-lg" type="submit">Send event request</button>
          <p class="micro recaptcha-note">This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy">Privacy Policy</a> and <a href="https://policies.google.com/terms">Terms of Service</a> apply.</p>
        </form>
        <div class="form-success"><h3>Thank you.</h3><p>Your event request is with the {loc.name} events team.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head reveal"><div><span class="eyebrow">{loc.key === "toronto" ? "Event FAQ" : "Vancouver FAQ"}</span><h2>Before you <em>book</em></h2></div><p>{pd.faqNote}</p></div>
      <div class="faq">
        {pd.faq.map((f) => <details><summary>{f.q}</summary><div class="answer">{f.a.map((p) => <p>{p}</p>)}</div></details>)}
      </div>
    </div>
  </section>
</main>
</Layout>
