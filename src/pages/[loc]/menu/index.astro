---
import Layout from "@/layouts/Layout.astro";
import LoopHero from "@/components/LoopHero.astro";
import { url, absolute, locHref } from "@/lib/url";
import { locations, type Location } from "@/data/locations";
import { dishes } from "@/data/dishes";

export function getStaticPaths() {
  return locations.map((loc) => ({ params: { loc: loc.slug }, props: { loc } }));
}
const { loc } = Astro.props as { loc: Location };
const hero = loc.heroes.menu!;
const menus = loc.menus;
/* An item with neither price nor description is a sub-heading the client uses inside a section ("Sushi Hand Rolls") */
const isSub = (i: { price: string; desc: string }) => !i.price && !i.desc;
const firstNumber = (p: string) => { const m = p.match(/\d+(\.\d+)?/); return m ? m[0] : null; };
const eyebrow: Record<string, string> = Object.fromEntries(loc.hours.map((x) => [x.label.toLowerCase().replace(" ", "-"), `${x.days} · ${x.time}`]));
const path = `${loc.slug}/menu/`;

const schema = [
  {
    "@context": "https://schema.org", "@type": "Menu", name: `${loc.name} menus`, url: absolute(path), inLanguage: "en-CA",
    hasMenuSection: menus.map((m) => ({
      "@type": "MenuSection", name: m.title,
      hasMenuSection: m.sections.map((s) => ({
        "@type": "MenuSection", name: s.title || m.title,
        hasMenuItem: s.items.filter((i) => !isSub(i)).map((i) => {
          const price = firstNumber(i.price);
          return { "@type": "MenuItem", name: i.name, description: i.desc || undefined,
            ...(price && !/per oz|MP|per\b/i.test(i.price) ? { offers: { "@type": "Offer", price, priceCurrency: "CAD" } } : {}) };
        }),
      })),
    })),
  },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: loc.name, item: absolute(`${loc.slug}/`) },
    { "@type": "ListItem", position: 2, name: "Menu", item: absolute(path) },
  ] },
];
---
<Layout
  title={`Menu | ${loc.name}: ${menus.map((m) => m.title).slice(0, 3).join(", ")}`.slice(0, 64)}
  description={`The ${loc.name} menus with prices: ${menus.map((m) => m.title.toLowerCase()).join(", ")}. Canadian Prime, A5 Wagyu and certified Kobe beef.`.slice(0, 155)}
  path={path} current="menu" schema={schema} loc={loc}
>
<main class="page">
  <LoopHero loop={hero.loop} label={hero.label}>
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url(`${loc.slug}/`)}>{loc.short}</a><span>/</span>Menu</nav>
      <h1 style="margin-top:1rem">{hero.title[0]} <em>{hero.title[1]}</em></h1>
    </div>
    <div>
      <p class="lede">{hero.lede}</p>
      <div class="actions"><a class="btn btn-solid btn-sm" href={loc.book}>Book a Table</a><a class="link-arrow" href="#dinner">Dinner menu</a></div>
    </div>
  </LoopHero>

  <nav class="menu-tabs" aria-label="Menus">
    <div class="wrap">{menus.map((m) => <a href={`#${m.id}`}>{m.title}</a>)}</div>
  </nav>

  {menus.map((m) => (
    <section class="menu-block" id={m.id}>
      <div class="wrap">
        <header>
          <div><span class="eyebrow">{eyebrow[m.id] ?? loc.name}</span><h2 style="margin-top:0.8rem">{m.title}{m.price && <> <em style="color:var(--gold)">{m.price}</em></>}</h2></div>
          {m.note && <p>{m.note}</p>}
        </header>
        <div class="menu-cols">
          {m.sections.map((s) => (
            <div class="menu-section">
              {s.title && <h3>{s.title}</h3>}
              {s.note && <p class="note">{s.note}</p>}
              {s.items.map((i) => isSub(i) ? <p class="menu-sub">{i.name}</p> : (
                <div class="menu-item">
                  <span class="name">{i.name}</span>
                  <span class="price">{i.price}</span>
                  {i.desc && <span class="desc">{i.desc}</span>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section tight">
    <div class="wrap">
      <p class="micro menu-legal">Prices in Canadian dollars and subject to applicable taxes; menus and availability may change. Please tell your server about any allergies or dietary restrictions. Group menus: <a href={loc.groupMenus}>Group Menus (PDF)</a>.</p>
      <!-- CONFIRM: allergen statement wording -->
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">The cuts, explained</span><h2>Know your <em>steak</em></h2></div><p>What sets each cut apart, and what it costs at Black+Blue.</p></div>
      <div class="dish-grid">{dishes.map((d) => <a href={url(`dishes/${d.slug}/`)}><strong>{d.name}</strong><span>{d.question}</span></a>)}</div>
    </div>
  </section>
</main>
</Layout>

<script>
  /* Sticky menu nav: mark the menu on screen */
  const links = [...document.querySelectorAll(".menu-tabs a")];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((a) => a.classList.toggle("is-current", a.getAttribute("href") === "#" + e.target.id));
  }), { rootMargin: "-30% 0px -60% 0px" });
  document.querySelectorAll(".menu-block").forEach((s) => io.observe(s));
</script>
