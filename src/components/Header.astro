---
import { site, type NavKey } from "../site.config";
import { url } from "../lib/url";

interface Props {
  /** Nav item marked aria-current="page" */
  current?: NavKey;
}
const { current } = Astro.props;
---
<header class="site-header">
  <a class="brand" href={url()} aria-label="Black+Blue Toronto, home">
    <img class="brand-mono" src={url("assets/brand/monogram.png")} alt="" width="121" height="120" />
    <span class="brand-text"><img src={url("assets/brand/wordmark.png")} alt="Black+Blue" width="292" height="37" /><small>Toronto</small></span>
  </a>
  <nav class="site-nav" id="site-nav" aria-label="Primary">
    {site.nav.map((item) => (
      <a href={url(item.href)} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
    ))}
    <a class="nav-extra" href={site.tel}>{site.phone}</a>
    <a class="header-cta" href={site.cta.href}>{site.cta.label}</a>
  </nav>
  <div class="header-right">
    <a class="header-cta" href={site.cta.href}>{site.cta.label}</a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span></button>
  </div>
</header>
