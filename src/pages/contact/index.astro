---
import Layout from "@/layouts/Layout.astro";
import ScrubHero from "@/components/ScrubHero.astro";
import { site } from "@/site.config";
import { url, absolute } from "@/lib/url";

const schema = [{
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absolute() },
    { "@type": "ListItem", position: 2, name: "Contact", item: absolute("contact/") },
  ],
}];
---
<Layout
  title="Contact & Hours | Black+Blue Toronto, 130 King St West"
  description="Black+Blue Toronto hours, phone, email, parking and directions: 130 King St West, Toronto, ON M5X 2A2 · 647.368.8283. Lunch, happy hour, dinner and brunch."
  path="contact/"
  current="contact"
  schema={schema}
>
<main class="page">
  <ScrubHero id="contact-hero" frames="frames/patio/pa_" poster="assets/img/patio.webp" label="The camera moves slowly through the garden dining room under hanging greenery">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Home</a><span>/</span>Contact</nav>
      <h1 style="margin-top:1rem">Contact <em>& Hours</em></h1>
    </div>
    <div>
      <p class="lede">130 King St West, Toronto, ON, M5X 2A2 · <a href={site.tel}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="actions"><a class="btn btn-solid btn-sm" href={site.book}>Book a Table</a><a class="link-arrow" href={url("private-dining/#inquiry")}>Event Request</a></div>
    </div>
  </ScrubHero>

  <section class="section">
    <div class="wrap visit">
      <div class="reveal">
        <h3>Contact</h3>
        <address>130 King St West<br />Toronto, ON, M5X 2A2</address>
        <p style="margin-top:1rem"><a class="tel-big" href={site.tel}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <div class="actions"><a class="btn" href={site.maps}>Directions</a><a class="link-arrow" href={site.giftCards}>Gift Cards</a></div>
      </div>
      <div class="reveal">
        <h3>Hours</h3>
        <dl class="hours">{site.hours.map((h) => <div><dt>{h.label}</dt><dd>{h.days}<span>{h.time}</span></dd></div>)}</dl>
        <!-- CONFIRM: brunch start (10:30am here, 11:00am on the current home page); upcoming holiday closures -->
      </div>
      <div class="reveal">
        <h3>Parking</h3>
        <div class="prose">
          <p style="font-size:0.92rem">24/7 Underground parking facilities @ First Canadian Place Towers/Exchange</p>
          <p style="font-size:0.92rem">Access from Adelaide & York Street (119 York St)</p>
          <p style="font-size:0.92rem">Weekday 6am-6pm $30 · Weekday 24 Hour Rate $40</p>
          <p style="font-size:0.92rem">Evening Flat Rate 6pm-6am $10 · Weekend & Holidays (per 24 hours): 6am-6am $12</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="form">
    <div class="wrap form-layout">
      <div class="sticky reveal">
        <span class="eyebrow">Write to us</span>
        <h2 class="h2" style="margin:1rem 0 1.4rem">Send a <em>message</em></h2>
        <p class="ink-soft">For reservations, please <a href={site.book}>book a table</a> online or call <a href={site.tel}>{site.phone}</a>. For groups and private dining, use the <a href={url("private-dining/#inquiry")}>event request</a>.</p>
      </div>
      <div>
        <form class="form reveal" method="post" data-form="contact" data-form-type="contact">
          <div class="row"><div class="field"><label for="c_name">Name*</label><input id="c_name" name="name" type="text" autocomplete="name" required /></div><div class="field"><label for="c_phone">Phone</label><input id="c_phone" name="phone" type="tel" autocomplete="tel" /></div></div>
          <div class="field"><label for="c_email">Email*</label><input id="c_email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="reason">About*</label><select id="reason" name="reason" required><option value="" disabled selected>Select…</option><option>A recent visit</option><option>Gift cards</option><option>Media & press</option><option>Something else</option></select></div>
          <div class="field"><label for="c_message">Message*</label><textarea id="c_message" name="message" required></textarea></div>
          <label class="check"><input type="checkbox" name="consent" value="yes" /> <span>Yes, I’d like to receive news, wine dinners and features by email. I can unsubscribe at any time.</span></label>
          <button class="btn btn-solid btn-lg" type="submit">Send message</button>
          <p class="micro recaptcha-note">This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy">Privacy Policy</a> and <a href="https://policies.google.com/terms">Terms of Service</a> apply.</p>
        </form>
        <div class="form-success"><h3>Thank you.</h3><p>Your message is with the Black+Blue Toronto team.</p></div>
      </div>
    </div>
  </section>
</main>
</Layout>
