---
import Layout from "@/layouts/Layout.astro";
import ScrubHero from "@/components/ScrubHero.astro";
import { site } from "@/site.config";
import { url, absolute } from "@/lib/url";

/* Copy verbatim from blackandbluesteakhouse.ca/toronto-a-superior-selection/ and /toronto-about/; prices from the dinner menu */
const lots = [
  {
    no: "Lot 01", where: "Canada", title: "Canadian Prime", img: "platter", alt: "Sliced Canadian Prime steak on a silver platter",
    body: "Canadian prime-grade beef features abundant marbling (red meat laced with an even fat distribution). The presence of this fat creates a more tender and juicy cut of beef that cooks well in all conditions. Only 2% of graded Canadian beef is rated prime.",
    spec: [["New York Striploin", "89 (14oz)"], ["Tenderloin", "89 (8oz)"], ["Rib Eye", "109 (14oz)"], ["Cowboy Rib-Eye", "235 (36oz)"], ["Prime Tomahawk | Porterhouse", "MP"]],
    link: "dishes/canadian-prime/",
  },
  {
    no: "Lot 02", where: "Japan · A5 · BMS 8–10", title: "Japanese A5 Wagyu", img: "striploin", alt: "A5 Wagyu striploin with dense marbling",
    body: "Japanese Wagyu cattle are known worldwide for producing meat with exceptional marbling, naturally enhanced flavour, tenderness and juiciness. All of our Japanese Wagyu cuts have a quality score of A5 and a marbling score between 8-10.",
    spec: [["Rib Eye", "28 per oz"], ["Striploin", "31 per oz"], ["Tenderloin", "39 per oz · limited"]],
    link: "dishes/a5-wagyu/",
  },
  {
    no: "Lot 03", where: "Hyogo, Japan · certified", title: "Japanese Kobe Beef", img: "kobe", alt: "Certified Kobe beef striploin beside its bronze bull certificate",
    body: "Black+Blue takes great pride in being one of the select few dining rooms in North America that offers certified Kobe beef ribeye and striploin cuts. The secret behind this prestige cut of meat is the umami flavour that’s embedded in the “shimofuri” marbling. The fatty “sashi” content dissolves at low temperatures, which literally means it melts in your mouth.",
    spec: [["Rib Eye", "52 per oz"], ["Striploin", "56 per oz"], ["Tenderloin", "69 per oz · limited"]],
    link: "dishes/kobe-beef/",
  },
  {
    no: "Lot 04", where: "Australia", title: "Australian Wagyu", img: "chopped-steak", alt: "",
    body: "Australian Wagyu is renowned for its exceptional marbling, rich flavour, and buttery tenderness. Raised in Australia using a combination of traditional Japanese breeding and Australian farming practices, this premium beef offers a beautiful balance of flavour.",
    spec: [["Striploin", "110 (10oz)"], ["Rib-Eye", "134 (10oz)"]],
    link: "menu/#dinner",
    noImage: true,
  },
];
const schema = [{
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absolute() },
    { "@type": "ListItem", position: 2, name: "A Superior Selection", item: absolute("superior-selection/") },
  ],
}];
---
<Layout
  title="Dry-Aged Steak, Kobe & A5 Wagyu in Toronto | Black+Blue"
  description="Dry-aged 28–45 days in a Himalayan salt-brick locker: Canadian Prime, Japanese A5 Wagyu, certified Kobe beef and Australian Wagyu at Black+Blue Toronto."
  path="superior-selection/"
  current="selection"
  schema={schema}
>
<main class="page">
  <ScrubHero id="selection-hero" frames="frames/striploin/st_" poster="assets/img/striploin.webp" label="The camera moves across a marbled Wagyu striploin">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Home</a><span>/</span>A Superior Selection</nav>
      <h1 style="margin-top:1rem">Superior selection, <em>superior flavour</em></h1>
    </div>
    <div>
      <p class="lede">We proudly display our beef in the centre of the dining room. The pale pink and orange wall is made of Himalayan salt bricks. The salt purifies the air and naturally removes moisture.</p>
    </div>
  </ScrubHero>

  <section class="section">
    <div class="wrap split">
      <figure class="print reveal" style="aspect-ratio:4/5"><img src={url("assets/img/salt-wall.webp")} alt="Dry-aging beef in front of the backlit Himalayan salt wall" loading="lazy" width="1078" height="1758" /></figure>
      <div class="reveal">
        <span class="eyebrow">The salt locker · 28 – 45 days</span>
        <h2>Dry-aged in <em>Himalayan salt</em></h2>
        <p>This dry-aging process infuses an unforgettable flavour as it tenderizes the meat. All our steaks are kept in the cooler for 28-45 days and ensures a flavour concentration of the highest quality.</p>
        <p>All beef is dry-aged in a one-of-a-kind Himalayan salt-lined meat locker, where guests can receive an interactive experience with a Black+Blue butcher to learn more about the restaurant’s unique steak program.</p>
        <div class="actions"><a class="btn btn-solid" href={site.book}>Book a Table</a><a class="link-arrow" href={url("dishes/dry-aged-steak/")}>What is dry-aged steak?</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><div><span class="eyebrow">The selection</span><h2>Four lots, <em>by the cut</em></h2></div><p>Kobe Beef Certified: one of the only license holders in Canada to sell certified Japanese Kobe Beef.</p></div>
      <div class="lots">
        {lots.map((l) => (
          <article class="lot-entry reveal" style={l.noImage ? "grid-template-columns:1fr" : undefined}>
            {!l.noImage && <figure class="print"><img src={url(`assets/img/${l.img}.webp`)} alt={l.alt} loading="lazy" width="1000" height="1000" /></figure>}
            <div style={l.noImage ? "max-width:760px" : undefined}>
              <span class="eyebrow">{l.no} · {l.where}</span>
              <h2>{l.title}</h2>
              <p>{l.body}</p>
              <dl class="lot-spec">{l.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
              <div class="actions" style="margin-top:1.6rem"><a class="link-arrow" href={url(l.link)}>{l.link.startsWith("dishes") ? "Read more" : "Dinner menu"}</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="distinctions">
        <div><strong>Steak Add Ons</strong><span>½ lb Alaskan King Crab · MP</span></div>
        <div><strong>½ Atlantic Lobster</strong><span>45</span></div>
        <div><strong>Trio of Sauces</strong><span>15</span></div>
        <div><strong>Béarnaise · Truffle Jus</strong><span>Red Wine Jus · Peppercorn · 5</span></div>
      </div>
    </div>
  </section>
</main>
</Layout>
