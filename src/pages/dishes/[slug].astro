---
import Layout from "@/layouts/Layout.astro";
import { locations } from "@/data/locations";
import { url, absolute } from "@/lib/url";
import { dishes, vanPrices, type Dish } from "@/data/dishes";

export function getStaticPaths() {
  return dishes.map((d) => ({ params: { slug: d.slug }, props: { dish: d } }));
}
const { dish } = Astro.props as { dish: Dish };
const van = vanPrices[dish.slug] ?? [];
const others = dishes.filter((d) => d.slug !== dish.slug);
const path = `dishes/${dish.slug}/`;
const schema = [
  {
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: [[dish.question, dish.answer], ...dish.faqs].map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Black+Blue", item: absolute() },
      { "@type": "ListItem", position: 2, name: "Menu", item: absolute("toronto/menu/") },
      { "@type": "ListItem", position: 3, name: dish.name, item: absolute(path) },
    ],
  },
];
---
<Layout
  title={`${dish.question.replace(/, and where can you eat it in Toronto\?/, "?")} | Black+Blue`.slice(0, 70)}
  description={dish.answer.slice(0, 155)}
  path={path}
  schema={schema}
>
<main class="page">
  <section class="page-hero">
    <div class="wrap split" style="align-items:end">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Black+Blue</a><span>/</span>{dish.name}</nav>
        <h1>{dish.question}</h1>
      </div>
      <figure class="print"><img src={url(`assets/img/${dish.img}.webp`)} alt={dish.alt} width="1600" height="1067" /></figure>
    </div>
  </section>
  <section class="section">
    <div class="wrap-narrow prose">
      <div class="answer-box"><p>{dish.answer}</p></div>
      {dish.body.map((p) => <p>{p}</p>)}
      <div class="at-bb">
        <span class="eyebrow">At Black+Blue</span>
        <p style="margin-top:1rem">{dish.atBB}</p>
        <div class="price-cols">
          <div><span class="mono">Toronto</span><dl class="lot-spec">{dish.prices.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div>
          {van.length > 0 && <div><span class="mono">Vancouver & The Roof</span><dl class="lot-spec">{van.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div>}
        </div>
        <div class="actions" style="margin-top:1.8rem">{locations.slice(0, 2).map((l, i) => <a class={i === 0 ? "btn btn-solid" : "btn"} href={l.book}>Book {l.short}</a>)}<a class="link-arrow" href={url("toronto/menu/#dinner")}>Toronto menu</a><a class="link-arrow" href={url("vancouver/menu/#dinner")}>Vancouver menu</a></div>
      </div>
      <h2>Questions</h2>
      <div class="faq">{dish.faqs.map(([q, a]) => <details><summary>{q}</summary><div class="answer"><p>{a}</p></div></details>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">More cuts</span>
      <div class="dish-grid" style="margin-top:1.4rem">{others.slice(0, 4).map((d) => <a href={url(`dishes/${d.slug}/`)}><strong>{d.name}</strong><span>{d.question}</span></a>)}</div>
    </div>
  </section>
</main>
</Layout>
