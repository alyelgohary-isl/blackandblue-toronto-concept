---
/* Mobile action bar: the four things a guest does from a phone, for the location being viewed. */
import type { Location } from "../data/locations";
import { url } from "../lib/url";

const { loc } = Astro.props as { loc?: Location };
---
{loc && (
  <nav class="action-bar" aria-label="Quick actions">
    <a href={loc.book}>Book</a>
    <a href={url(`${loc.slug}/menu/`)}>Menu</a>
    <a href={loc.tel}>Call</a>
    <a href={loc.maps}>Directions</a>
  </nav>
)}
