---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/site.config";
import { url } from "@/lib/url";
---
<Layout title="Legal | Black+Blue Toronto" description="Legal notices, privacy and imagery notes for the Black+Blue Toronto website." path="legal/">
<main class="page">
  <section class="page-hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Home</a><span>/</span>Legal</nav>
      <h1>Legal</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap-narrow prose">
      <!-- CONFIRM: terms and privacy copy from Glowbal Restaurant Group -->
      <h2>Concept preview</h2>
      <p>This is a concept website prepared for Black+Blue Toronto. It is not the restaurant’s live website and is not indexed by search engines. Menus, prices and hours were taken from blackandbluesteakhouse.ca; the restaurant’s current printed menu prevails.</p>
      <h2>Prices</h2>
      <p>Prices are in Canadian dollars, are subject to applicable taxes and gratuities, and may change. Market price (MP) items and limited cuts depend on daily availability.</p>
      <h2>Imagery</h2>
      <p>All photographs are Black+Blue’s own. Short motion sequences on this site were made from those photographs with image-to-video tools; no dish, room or ingredient was added.</p>
      <h2>Privacy and communications</h2>
      <p>Information sent through a form on this site is used only to reply to your request. If you tick the consent box, you agree to receive news from {site.name} by email and can unsubscribe at any time by writing to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</main>
</Layout>
