---
import Layout from "@/layouts/Layout.astro";
import ScrubHero from "@/components/ScrubHero.astro";
import { site } from "@/site.config";
import { url, absolute } from "@/lib/url";
import { menus } from "@/data/menu";
import { dishes } from "@/data/dishes";

/* An item with neither price nor description is a sub-heading the client uses inside a section ("Sushi Hand Rolls") */
const isSub = (i: { price: string; desc: string }) => !i.price && !i.desc;
const firstNumber = (p: string) => { const m = p.match(/\d+(\.\d+)?/); return m ? m[0] : null; };

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Menu",
    name: "Black+Blue Toronto menus",
    url: absolute("menu/"),
    inLanguage: "en-CA",
    hasMenuSection: menus.map((m) => ({
      "@type": "MenuSection",
      name: m.title,
      hasMenuSection: m.sections.map((s) => ({
        "@type": "MenuSection",
        name: s.title || m.title,
        hasMenuItem: s.items.filter((i) => !isSub(i)).map((i) => {
          const price = firstNumber(i.price);
          return {
            "@type": "MenuItem", name: i.name, description: i.desc || undefined,
            ...(price && !/per oz|MP/i.test(i.price) ? { offers: { "@type": "Offer", price, priceCurrency: "CAD" } } : {}),
          };
        }),
      })),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absolute() },
      { "@type": "ListItem", position: 2, name: "Menu", item: absolute("menu/") },
    ],
  },
];
---
<Layout
  title="Menu | Black+Blue Toronto Steakhouse, Dinner, Lunch & Brunch"
  description="The Black+Blue Toronto menus with prices: dinner, raw bar, lunch, Lunch 45, prix fixe, weekend brunch, happy hour and dessert. Kobe, A5 Wagyu and Canadian Prime."
  path="menu/"
  current="menu"
  schema={schema}
>
<main class="page">
  <ScrubHero id="menu-hero" frames="frames/platter/pl_" poster="assets/img/platter.webp" label="Sliced steak on a silver platter, rosemary smoking, steam rising from copper pots of sides">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Home</a><span>/</span>Menu</nav>
      <h1 style="margin-top:1rem">Menus</h1>
    </div>
    <div>
      <p class="lede">Classic steakhouse offerings with a twist, and the world’s most premium cuts of meat. Dinner nightly from 3:00pm; lunch Monday to Friday; brunch on weekends.</p>
      <div class="actions"><a class="btn btn-solid btn-sm" href={site.book}>Book a Table</a><a class="link-arrow" href="#dinner">Dinner menu</a></div>
    </div>
  </ScrubHero>

  <nav class="menu-tabs" aria-label="Menus">
    <div class="wrap">{menus.map((m) => <a href={`#${m.id}`}>{m.title}</a>)}</div>
  </nav>

  {menus.map((m) => (
    <section class="menu-block" id={m.id}>
      <div class="wrap">
        <header>
          <div><span class="eyebrow">{m.id === "dinner" ? "Daily · from 3:00pm" : m.id === "lunch" ? "Monday – Friday · 11:30am – 2:00pm" : m.id === "brunch" ? "Saturday & Sunday" : m.id === "happy-hour" ? "Daily · 2:30pm – 5:30pm" : "Black+Blue Toronto"}</span><h2 style="margin-top:0.8rem">{m.title}{m.price && <> <em style="color:var(--gold)">{m.price}</em></>}</h2></div>
          {m.note && <p>{m.note}</p>}
        </header>
        <div class="menu-cols">
          {m.sections.map((s) => (
            <div class="menu-section">
              {s.title && <h3>{s.title}</h3>}
              {s.note && <p class="note">{s.note}</p>}
              {s.items.map((i) => isSub(i) ? <p class="menu-sub">{i.name}</p> : (
                <div class="menu-item">
                  <span class="name">{i.name}</span>
                  <span class="price">{i.price}</span>
                  {i.desc && <span class="desc">{i.desc}</span>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section tight">
    <div class="wrap">
      <p class="micro menu-legal">Prices in Canadian dollars and subject to applicable taxes; menus and availability may change. Please tell your server about any allergies or dietary restrictions. Wellington Mondays and group menus: <a href="https://blackandbluesteakhouse.ca/wp-content/uploads/2025/02/bb-to-Wellington-Mondays-2024.pdf">Wellington Mondays (PDF)</a> · <a href="https://blackandbluesteakhouse.ca/wp-content/uploads/2026/09/BB-TO-Group-Menus-2026-5.pdf">Group Menus (PDF)</a>.</p>
      <!-- CONFIRM: allergen statement wording -->
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">The cuts, explained</span><h2>Know your <em>steak</em></h2></div><p>What sets each cut apart, and what it costs here.</p></div>
      <div class="dish-grid">{dishes.map((d) => <a href={url(`dishes/${d.slug}/`)}><strong>{d.name}</strong><span>{d.question}</span></a>)}</div>
    </div>
  </section>
</main>
</Layout>

<script>
  /* Sticky menu nav: mark the menu on screen */
  const links = [...document.querySelectorAll(".menu-tabs a")];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((a) => a.classList.toggle("is-current", a.getAttribute("href") === "#" + e.target.id));
  }), { rootMargin: "-30% 0px -60% 0px" });
  document.querySelectorAll(".menu-block").forEach((s) => io.observe(s));
</script>
