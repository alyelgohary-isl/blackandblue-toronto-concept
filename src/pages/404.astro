---
import Layout from "@/layouts/Layout.astro";

import { url } from "@/lib/url";
---
<Layout title="Page not found | Black+Blue Toronto" description="This page has moved." path="404/">
<main class="page">
  <section class="page-hero" style="border:0">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This lot has been <em>withdrawn.</em></h1>
      <div class="actions"><a class="btn btn-solid" href={url("toronto/")}>Toronto</a><a class="btn" href={url("vancouver/")}>Vancouver</a><a class="btn" href={url("the-roof/")}>The Roof</a></div>
    </div>
  </section>
</main>
</Layout>
